# Copy to dev/.env and fill in. setup.sh does this for you.

# --- NAS / NFS (required) ---------------------------------------------------
# IP address of the NAS. Use the address, not a hostname: the NFS mount is
# performed by the Docker daemon, which does not use your /etc/hosts.
NAS_HOST=192.168.1.10

# The exported path, exactly as `showmount -e $NAS_HOST` prints it.
NAS_BOOKS_EXPORT=/export/Flibusta.Net

# --- Ports (host side) ------------------------------------------------------
DEV_HTTP_PORT=8080
DEV_PG_PORT=25432
DEV_REDIS_PORT=26379

# --- App ---------------------------------------------------------------------
TZ=Europe/Moscow
DEV_ADMIN_USER=admin

# Per-request DB connection/statement counts in the php-fpm log.
FLIBUSTA_DEBUG_DB=true

# Empty means every request must log in, which is what you usually want in dev.
# Set to the Docker bridge network to test trusted-network behaviour instead,
# e.g. FLIBUSTA_TRUSTED_NET=172.16.0.0/12
FLIBUSTA_TRUSTED_NET=

# Set to empty to run the stack with Redis disabled (sessions back in Postgres,
# caches off) and check that everything still works on the no-cache path.
FLIBUSTA_REDIS_HOST=redis

# Mirror to fetch dumps and on-the-fly books from.
FLIBUSTA_URL=https://flibusta.is
